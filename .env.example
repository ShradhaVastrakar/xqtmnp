# Copy to .env (docker compose reads it automatically). No secrets are required:
# the Elexon BMRS open-data API used here needs no API key.

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser-facing backend URL, baked into the frontend build
VITE_API_URL=https://int-sol-back.khelo.tech


# Frontend origin(s) allowed by the backend CORS policy (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Day-ahead decision cutoff - a pilot ASSUMPTION, not an official market rule
DECISION_CUTOFF_TIME=09:00
DECISION_CUTOFF_DAYS_AHEAD=1

# "none": strict startTime match (:30 half-hours have no forecast).
# "hold": reuse the hourly WINDFOR value for both half-hours of that hour.
HOURLY_FORECAST_FILL=none

CACHE_TTL_HOURS=24
